# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=supersecretkey-change-in-production-32chars
ADMIN_PASSWORD=admin

# ── Network ───────────────────────────────────────────────────────────────────
PORT=80
CORS_ORIGINS=*

# ── AI / OCR ──────────────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: increases Google Books quota (https://console.cloud.google.com)
# Without key: 1000 req/day; with key: 1000 req/day per project (free tier)
GOOGLE_BOOKS_API_KEY=

# Fallback AI used automatically when Gemini hits its rate limit.
# Requires an API key from https://console.anthropic.com (the Claude Pro
# chat subscription is NOT an API key — API billing is separate).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Data directories (bind mounts — set absolute paths on a NAS) ──────────────
# Default: ./data/* next to docker-compose.yml
POSTGRES_DATA_DIR=./data/postgres
REDIS_DATA_DIR=./data/redis
UPLOADS_DIR=./data/uploads
